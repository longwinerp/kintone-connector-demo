// 要連自己的 Kintone 時，把這個檔案的內容合併到 appsettings.json，
// 或另存成 appsettings.Local.json（已列入 .gitignore，不會被推上 GitHub）。
//
// 提醒：ApiToken 與 GatewayApiKey 請用 User Secrets 或環境變數提供，不要寫進版控。
{
  "Kintone": {
    "TimeoutSeconds": 30,
    "MaxResponseBytes": 10485760,

    // 呼叫端自行輸入 URL／App ID／Token 時的規則
    "AdHoc": {
      "Enabled": true,
      "AllowedHostSuffixes": [ "cybozu.com", "kintone.com" ]
    },

    "Profiles": {
      // 內建示範資料，不會連出去
      "Demo": {
        "DisplayName": "示範資料（請款單，不需 Token）",
        "AppId": 1,
        "IsDemo": true,
        "Enabled": true
      },

      // 真正的 Kintone App
      "MyApp": {
        "DisplayName": "我的 Kintone App",
        "BaseUrl": "https://example.cybozu.com",
        "ApiPath": "/k/v1/records.json",
        "AppId": 100,
        "ApiToken": "",
        "Enabled": true
      }

      // Guest Space 的 App，改 ApiPath 即可
      // "GuestApp": {
      //   "DisplayName": "Guest Space 的 App",
      //   "BaseUrl": "https://example.cybozu.com",
      //   "ApiPath": "/k/guest/12/v1/records.json",
      //   "AppId": 200,
      //   "ApiToken": "",
      //   "Enabled": true
      // }
    }
  },

  "Security": {
    // 正式環境必填；開發機由 localhost 存取時可留空
    "GatewayApiKey": ""
  }
}
